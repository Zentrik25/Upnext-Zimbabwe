# UPNEXT production server block, behind the shared edge (Traefik) which terminates TLS (OQ-10, unverified).
# Rendered by the nginx image from /etc/nginx/templates (only UPNEXT_* variables are substituted).
# Only the host upnext.co.zw is served. No `www` host, no other host and no redirect exists: any other Host
# header gets no answer (444).
server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Real client address: only the edge range may state it (X-Forwarded-For), nobody else.
set_real_ip_from ${UPNEXT_EDGE_CIDR};
real_ip_header   X-Forwarded-For;
real_ip_recursive on;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name upnext.co.zw;
    client_max_body_size 1m;

    # Plain http can only be seen from the edge, which has already enforced https for this host.
    proxy_set_header Host              upnext.co.zw;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID      $request_id;
    proxy_http_version 1.1;
    proxy_read_timeout 30s;

    # Staff image uploads (D-58): the file is at most 5 MB, so this one path may carry a larger body.
    location = /api/v1/staff/images {
        client_max_body_size 6m;
        proxy_pass http://api:8000;
    }

    # Uploaded listing images (D-58): only generated names, read-only from the persistent media volume, never
    # executed or sniffed, cached for a long time because a name is never reused for different content.
    location ~ ^/media/listings/[0-9a-f]{32}\.jpg$ {
        root /srv;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        try_files $uri =404;
    }
    location /media/ {
        return 404;
    }

    location ~ ^/(api|health|django-admin|static)/ {
        proxy_pass http://api:8000;
    }

    location / {
        proxy_pass http://web:3000;
        # nginx drops inherited proxy_set_header directives as soon as a location sets its own, so repeat them.
        proxy_set_header Host              upnext.co.zw;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID      $request_id;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
