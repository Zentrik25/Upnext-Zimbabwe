# Copy to infrastructure/compose/.env (git-ignored) and replace every CHANGE_ME with a random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_DB=upnext
POSTGRES_USER=upnext
POSTGRES_PASSWORD=CHANGE_ME
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Optional
UPNEXT_HTTP_PORT=8080
# UPNEXT_UID=1000        # set to your own uid/gid if the bind-mounted source must be writable
# UPNEXT_GID=1000
# TLS-intercepting networks only (build time): set both lines, see LOCAL_DEVELOPMENT.md
# COMPOSE_FILE=compose.yaml:compose.ca-bundle.yaml
# UPNEXT_CA_BUNDLE=/path/to/corporate-ca.pem
