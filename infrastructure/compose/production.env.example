# UPNEXT Careers (D-42; formerly NextJob Zimbabwe, D-33) — production settings TEMPLATE. Not used by any compose file; nothing here is deployed.
# Real values live in the approved secret store, never in git. Secrets are intentionally blank.
# Full procedure: docs/engineering/RESEND_INTEGRATION.md, DOMAIN_AND_DNS_SETUP.md, PRODUCTION_CONFIGURATION.md

# --- Public identity (canonical URLs, sitemap, robots, Open Graph and e-mailed links all derive from this)
UPNEXT_PUBLIC_BASE_URL=https://upnext.co.zw
UPNEXT_ENVIRONMENT=production

# --- Google AdSense (DRAFT, owner request 2026-11-03). Leave ALL BLANK: no Google script is loaded and no ad is shown.
# UPNEXT_ADSENSE_CLIENT alone only serves /ads.txt (no Google script, no ads); it answers 404 while blank.
# Advertising is a recorded non-goal (P4-04); set these only after the owner's explicit decision, reviewed privacy text and
# AdSense approval. See docs/engineering/ADSENSE_SITE_VERIFICATION.md. No real id is stored in git.
UPNEXT_ADSENSE_CLIENT=
# verify = ownership snippet only (no ads); live = labelled ads, loaded only after the visitor agrees. Blank = off.
UPNEXT_ADSENSE_MODE=
# Ad-unit ids created in AdSense after approval, one per placement (digits only).
UPNEXT_ADSENSE_SLOT_JOB_DETAIL=
UPNEXT_ADSENSE_SLOT_GUIDE=

# --- Brand and the one official mailbox (D-42). These are the defaults in code; they are listed so a deployment
# can see them. No other mailbox (support@, careers@ ...) exists or is invented. noreply@upnext.co.zw is a send-only From address (D-52), not a mailbox.
UPNEXT_BRAND_NAME=UPNEXT Careers
UPNEXT_BRAND_SHORT=UPNEXT
UPNEXT_BRAND_DOMAIN=upnext.co.zw
UPNEXT_OFFICIAL_EMAIL=info@upnext.co.zw
UPNEXT_SUPPORT_EMAIL=info@upnext.co.zw

# --- Transactional e-mail through Resend SMTP (D-34). Sending stays off until backend=smtp AND a current
# delivery-verification record exists (docs/engineering/EMAIL_DELIVERY_VERIFICATION.md).
UPNEXT_EMAIL_BACKEND=none
# The From address is fixed in compose.production.yaml (UPNEXT Careers <noreply@upnext.co.zw>, D-52); only Reply-To is read from here.
UPNEXT_EMAIL_FROM=UPNEXT Careers <noreply@upnext.co.zw>
UPNEXT_EMAIL_REPLY_TO=info@upnext.co.zw
UPNEXT_SMTP_HOST=smtp.resend.com
UPNEXT_SMTP_PORT=465
UPNEXT_SMTP_SECURITY=ssl
UPNEXT_SMTP_USER=resend
UPNEXT_SMTP_PASSWORD=
# Resend webhook signing secret ("whsec_..."); the endpoint is off while blank.
UPNEXT_RESEND_WEBHOOK_SECRET=

# --- Required by compose.production.yaml (a missing value is a hard error; there are no default secrets)
POSTGRES_DB=upnext
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_MIGRATOR_USER=
POSTGRES_MIGRATOR_PASSWORD=
DJANGO_SECRET_KEY=
UPNEXT_TOKEN_KEY=
UPNEXT_THROTTLE_PEPPER=
UPNEXT_DB_APP_PASSWORD=
UPNEXT_DB_READONLY_PASSWORD=
UPNEXT_RELEASE=
# Address range of the shared edge (Traefik); unknown until the read-only inspection (OQ-10). Do not guess.
UPNEXT_EDGE_CIDR=

# --- Sign in with Google (D-50). Leave empty to keep the button disabled. Create an OAuth client (type: web application)
# in Google Cloud, add https://upnext.co.zw/api/v1/auth/google/callback as an authorised redirect URI, then set both.
UPNEXT_GOOGLE_CLIENT_ID=
UPNEXT_GOOGLE_CLIENT_SECRET=

# --- Legal pages (D-44). Keep false until the owner has completed docs/legal/LEGAL_APPROVAL_CHECKLIST.md.
# While false, /privacy and /terms are noindex and absent from the sitemap. Only the owner sets it to true.
UPNEXT_LEGAL_APPROVED=false

# --- Google Indexing API for job pages (D-68, DRAFT). Used only with compose.production.indexing.yaml; without that
# overlay nothing is recorded or sent. Read docs/engineering/GOOGLE_INDEXING_API.md first. Never commit the key.
# UPNEXT_INDEXING_KEY_HOST_PATH=/etc/upnext/google-indexing.json
# UPNEXT_INDEXING_DAILY_QUOTA=200
# --- Landing pages (D-68): open listings a /jobs/* page needs before it is indexed and listed in the sitemap.
UPNEXT_LANDING_MIN_LISTINGS=3
