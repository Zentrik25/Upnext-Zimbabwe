# NextJob Zimbabwe (D-33) — production settings TEMPLATE. Not used by any compose file; nothing here is deployed.
# Real values live in the approved secret store, never in git. Secrets are intentionally blank.
# Full procedure: docs/engineering/RESEND_INTEGRATION.md, DOMAIN_AND_DNS_SETUP.md, PRODUCTION_CONFIGURATION.md

# --- Public identity (canonical URLs, sitemap, robots, Open Graph and e-mailed links all derive from this)
UPNEXT_PUBLIC_BASE_URL=https://nextjob.co.zw
UPNEXT_ENVIRONMENT=production

# --- Mailboxes. Names are approved (D-33); the owner must still create/verify each mailbox. The website shows
# only the addresses set here, so leave one blank until that mailbox exists.
UPNEXT_CONTACT_EMAIL=
UPNEXT_SUPPORT_EMAIL=
UPNEXT_JOBS_EMAIL=
UPNEXT_PARTNERSHIPS_EMAIL=
# Approved target values:  info@ / support@ / jobs@ / partnerships@ nextjob.co.zw

# --- Transactional e-mail through Resend SMTP (D-34). Sending stays off until backend=smtp AND a current
# delivery-verification record exists (docs/engineering/EMAIL_DELIVERY_VERIFICATION.md).
UPNEXT_EMAIL_BACKEND=none
UPNEXT_EMAIL_FROM=NextJob Zimbabwe <notifications@nextjob.co.zw>
UPNEXT_EMAIL_REPLY_TO=support@nextjob.co.zw
UPNEXT_SMTP_HOST=smtp.resend.com
UPNEXT_SMTP_PORT=465
UPNEXT_SMTP_SECURITY=ssl
UPNEXT_SMTP_USER=resend
UPNEXT_SMTP_PASSWORD=
# Resend webhook signing secret ("whsec_..."); the endpoint is off while blank.
UPNEXT_RESEND_WEBHOOK_SECRET=
