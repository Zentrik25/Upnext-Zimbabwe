{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://upnext.invalid/schemas/graduate-programmes/v1",
 "title": "Graduate programmes — detail",
 "description": "Graduate trainee, management-associate and other entry-level structured programmes. DRAFT v1 — NOT APPROVED (OQ-06). Not the implementation location (apps/api is created in Phase 1/2).",
 "x-status": "DRAFT",
 "x-open": "OQ-06",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "programme_length_months": {
   "type": "integer",
   "minimum": 3,
   "maximum": 60
  },
  "intake_year": {
   "type": "integer",
   "minimum": 2024,
   "maximum": 2100
  },
  "rotations": {
   "type": "boolean"
  },
  "minimum_degree_class": {
   "enum": [
    "first",
    "upper_second",
    "lower_second",
    "third",
    "pass",
    "not_stated"
   ]
  },
  "eligible_fields_of_study": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 2,
    "maxLength": 100
   },
   "minItems": 0,
   "maxItems": 15,
   "uniqueItems": true
  },
  "max_years_since_graduation": {
   "type": "integer",
   "minimum": 0,
   "maximum": 15
  },
  "service_bond_stated": {
   "type": "boolean"
  },
  "vacancies": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1000
  },
  "application_documents": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 2,
    "maxLength": 100
   },
   "minItems": 0,
   "maxItems": 20,
   "uniqueItems": true
  }
 },
 "required": []
}