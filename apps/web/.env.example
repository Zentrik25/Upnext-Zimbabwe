# Server-side URL of the Django API (Compose service name). Never exposed to the browser.
API_INTERNAL_URL=http://api:8000
NEXT_TELEMETRY_DISABLED=1

# Public identity (D-42). The canonical origin for links, sitemap, robots and Open Graph; production: https://upnext.co.zw
# UPNEXT_PUBLIC_BASE_URL=https://upnext.co.zw
# Mailboxes shown on /contact; each is shown only when set (the owner verifies the mailbox exists first).
# UPNEXT_CONTACT_EMAIL=
# UPNEXT_SUPPORT_EMAIL=
# UPNEXT_JOBS_EMAIL=
# UPNEXT_PARTNERSHIPS_EMAIL=
